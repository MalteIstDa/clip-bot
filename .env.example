# Diese Datei nach ".env" kopieren und ausfuellen. NIEMALS weitergeben oder hochladen.

# YouTube: OAuth-Client (Typ "Desktop-App") aus der Google Cloud Console, als JSON heruntergeladen
YOUTUBE_CLIENT_SECRETS=client_secret.json

# TikTok: App auf developers.tiktok.com (Login Kit + Content Posting API mit "Direct Post")
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# Instagram: langlebiger Access-Token je Konto (Name frei waehlbar, in config.yaml referenziert)
IG_TOKEN_N3ON=
