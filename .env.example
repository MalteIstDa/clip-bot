# Diese Datei nach ".env" kopieren und ausfuellen. NIEMALS weitergeben oder hochladen.

# YouTube: OAuth-Client (Typ "Desktop-App") aus der Google Cloud Console, als JSON heruntergeladen
YOUTUBE_CLIENT_SECRETS=client_secret.json

# TikTok: App auf developers.tiktok.com (Login Kit + Content Posting API mit "Direct Post")
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=

# Instagram: langlebiger Access-Token je Konto (Name frei waehlbar, beim Konto im Dashboard eintragen)
IG_TOKEN_N3ON=

# KI (nur noetig, wenn in den Einstellungen 'Claude' gewaehlt ist): Schluessel von console.anthropic.com
ANTHROPIC_API_KEY=

# Erklaervideos: Sprecherstimme von elevenlabs.io (Profil -> API Keys)
ELEVENLABS_API_KEY=

# Reminder in einen Discord-Kanal (optional): Kanal bearbeiten -> Integrationen -> Webhooks -> URL kopieren
DISCORD_WEBHOOK_URL=
